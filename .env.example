# Copy to .env and fill in. Never commit the filled-in file.
# Startup fails fast if any required value is missing, short, or a known
# placeholder — see app/lib/env.ts.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/workarail

# Public origin of the app, used for auth callbacks and links in emails.
APP_URL=http://localhost:3000

# Session signing key. Minimum 32 characters.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Encrypts secrets at rest, currently the SMTP password. Minimum 32 characters.
# Rotating this invalidates stored secrets; re-enter them in Settings after.
#   openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Optional. Google sign-in is only offered when both are set to real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Bootstraps the first administrator via scripts/seed-admin.ts,
# since public sign-up is disabled.
ADMIN_EMAIL=shubhamd@tvita.in
ADMIN_PASSWORD=Pass123
